{
  "name": "05-trailer-commit-before-created",
  "why": "the trailer commit predates created, so --since-as-filter excludes it",
  "prompt": {
    "id": "p1",
    "created": "2026-10-05",
    "outputs": [
      {
        "repo": "acme/corpus",
        "path": "scripts/a.ts",
        "kind": "file"
      }
    ]
  },
  "steps": [
    {
      "commit": {
        "date": "2026-10-04T12:00:00Z",
        "message": "feat: a\n\nPrompt-Id: p1",
        "files": {
          "scripts/a.ts": "a\n"
        }
      }
    }
  ],
  "expected": {
    "acme/corpus scripts/a.ts": "NOT-DELIVERED"
  }
}
