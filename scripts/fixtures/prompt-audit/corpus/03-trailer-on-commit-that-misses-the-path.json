{
  "name": "03-trailer-on-commit-that-misses-the-path",
  "why": "the trailer commit touches another file; the declared file is NOT-DELIVERED, the other one is DELIVERED",
  "prompt": {
    "id": "p1",
    "created": "2026-10-05",
    "outputs": [
      {
        "repo": "acme/corpus",
        "path": "scripts/a.ts",
        "kind": "file"
      },
      {
        "repo": "acme/corpus",
        "path": "scripts/other.ts",
        "kind": "file"
      }
    ]
  },
  "steps": [
    {
      "commit": {
        "date": "2026-10-04T12:00:00Z",
        "message": "init",
        "files": {
          "scripts/a.ts": "a\n",
          "scripts/other.ts": "o\n"
        }
      }
    },
    {
      "commit": {
        "date": "2026-10-06T12:00:00Z",
        "message": "feat: other\n\nPrompt-Id: p1",
        "files": {
          "scripts/other.ts": "o2\n"
        }
      }
    }
  ],
  "expected": {
    "acme/corpus scripts/a.ts": "NOT-DELIVERED",
    "acme/corpus scripts/other.ts": "DELIVERED"
  }
}
